# TrackCodex Backend - Railway Environment Variables

# ── Database ──
# This is automatically injected by Railway when you add the Postgres plugin
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# ── Server configuration ──
NODE_ENV=production
# PORT is automatically injected by Railway
PORT=4000 

# ── Security Keys ──
# IMPORTANT: Generate secure random strings for these in production!
ENCRYPTION_KEY=your-32-char-minimum-encryption-key-for-prod
COOKIE_SECRET=your-32-char-minimum-cookie-secret-for-prod
JWT_SECRET=your-32-char-minimum-jwt-secret-for-prod

# ── Frontend Connection ──
FRONTEND_URL=https://trackcodex.com
OPENVSCODE_URL=https://ide.trackcodex.com

# ── Third Party Oauth (Optional) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
